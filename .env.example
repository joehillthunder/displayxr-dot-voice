# Copy to .env (setup-windows.bat does this and fills in random secrets). Never commit .env.

# Only the voice fallback needs this. Mock mode, Claude and ChatGPT/dots don't.
OPENAI_API_KEY=

# Bearer token every MCP client sends: "Authorization: Bearer <MCP_AUTH_TOKEN>".
MCP_AUTH_TOKEN=change-me-long-random
# Shared secret between the bridge, the MCP server and the display page.
BRIDGE_SECRET=change-me-long-random

BRIDGE_PORT=8787
MCP_PORT=8790
VOICE_PORT=8791

# Optional.
# BRIDGE_HOST=127.0.0.1        # 0.0.0.0 lets a display on another LAN machine connect
# MCP_PUBLIC_HOSTS=            # hostnames a tunnel forwards with, e.g. dxr.example.com
# ASSET_URL_ALLOWLIST=         # extra https prefixes for show_model/show_splat {url}, comma-separated
# MCP_RATE_PER_MIN=20
# MCP_RATE_BURST=5
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
